// Prisma 7 Schema. Die Verbindungs-URL steht in prisma.config.ts.
// Modelle entstehen Feature fuer Feature (siehe docs/backlog.md).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// --- F-001 Terminplan und Slots pflegen (BR6, BR7) ---

enum Halbtag {
  VORMITTAG
  NACHMITTAG
}

enum SlotArt {
  NORMAL
  AKUT
}

enum SlotStatus {
  FREI
  BELEGT
}

model Aerztin {
  id           Int                @id @default(autoincrement())
  name         String
  slots        Slot[]
  terminarten  AerztinTerminart[]
  termine      Termin[]
  abwesenheiten Abwesenheit[]
  rezepteFreigegeben Rezeptantrag[] @relation("RezeptFreigegeben")
  erstgespraeche Erstgespraech[]
  nachtraege    Nachtrag[] @relation("NachtragAbsprache")

  @@map("aerztin")
}

model Terminart {
  id           Int                @id @default(autoincrement())
  bezeichnung  String             @unique
  dauerMinuten Int
  onlineBuchbar Boolean           @default(false)
  aerztinnen   AerztinTerminart[]
  termine      Termin[]

  @@map("terminart")
}

// n:m "Aerztin darf Terminart durchfuehren" (SPEC Beziehung 4).
model AerztinTerminart {
  aerztinId   Int
  terminartId Int
  aerztin     Aerztin   @relation(fields: [aerztinId], references: [id], onDelete: Cascade)
  terminart   Terminart @relation(fields: [terminartId], references: [id], onDelete: Cascade)

  @@id([aerztinId, terminartId])
  @@map("aerztin_terminart")
}

model Slot {
  id       Int        @id @default(autoincrement())
  datum    DateTime
  beginn   String     // Uhrzeit "HH:MM", Beginn des Slots
  halbtag  Halbtag
  art      SlotArt    @default(NORMAL)
  status   SlotStatus @default(FREI)
  aerztinId Int
  aerztin  Aerztin    @relation(fields: [aerztinId], references: [id], onDelete: Cascade)
  termin   Termin?

  // Ein Slot je Aerztin, Tag und Uhrzeit (Grundlage fuer "ein Slot, ein Termin").
  @@unique([aerztinId, datum, beginn])
  @@map("slot")
}

// --- F-002 Online-Termin buchen (BR5, BR6, BR9) ---

enum Versicherungsart {
  GESETZLICH
  PRIVAT
}

enum PatientStatus {
  NEU
  BESTAND
}

enum TerminStatus {
  GEBUCHT
  ERSCHIENEN
  ABSAGT
  NO_SHOW
  BETROFFEN
}

enum TerminKanal {
  TELEFON
  TRESEN
  ONLINE
}

model Patient {
  id                   Int              @id @default(autoincrement())
  name                 String
  versicherungsart     Versicherungsart
  // Schluessel je Versicherungsart (SPEC 2): gesetzlich ueber Versichertennummer,
  // privat ueber interne Patientennummer. Beide optional, aber eindeutig.
  versichertennummer   String?          @unique
  patientennummer      String?          @unique
  status               PatientStatus    @default(BESTAND)
  onlineBuchungGesperrt Boolean         @default(false)
  termine              Termin[]
  einwilligungen       Einwilligung[]
  erinnerungen         Erinnerung[]
  rezeptantraege       Rezeptantrag[]
  erstgespraeche       Erstgespraech[]

  @@map("patient")
}

model Termin {
  id                   Int            @id @default(autoincrement())
  status               TerminStatus   @default(GEBUCHT)
  kanal                TerminKanal    @default(ONLINE)
  nachtraeglichErfasst Boolean        @default(false)
  dringlichkeit        String?
  // BR2: Datum des No-Shows und ein triftiger Grund, der den Zaehler nicht
  // erhoeht (MFA-Ermessen).
  noShowAm             DateTime?
  triftigerGrund       String?
  patientId            Int
  aerztinId            Int
  terminartId          Int
  // Nur bei manuell erfassten Terminen (Telefon/Tresen) gesetzt; Online-
  // Buchungen haben keine MFA (SPEC Beziehung 10).
  erfasstVonId         Int?
  // BR5: hoechstens ein Termin je Slot. Die Eindeutigkeit erzwingt das auf
  // Datenbank-Ebene, unabhaengig vom Kanal. F-010: Ein nachtraeglich erfasster
  // Kulanz-Termin hat keinen Slot (W2: "ohne einen Slot zu belegen").
  slotId               Int?           @unique
  patient              Patient        @relation(fields: [patientId], references: [id])
  aerztin              Aerztin        @relation(fields: [aerztinId], references: [id])
  terminart            Terminart      @relation(fields: [terminartId], references: [id])
  slot                 Slot?          @relation(fields: [slotId], references: [id])
  erfasstVon           MFA?           @relation(fields: [erfasstVonId], references: [id])
  erinnerungen         Erinnerung[]
  erstgespraech        Erstgespraech?
  nachtrag             Nachtrag?

  @@map("termin")
}

// --- F-003 Abwesenheit und Praxisschliessung (BR4) ---

enum Geltungsbereich {
  AERZTIN
  PRAXIS
}

enum AbwesenheitArt {
  URLAUB
  BRUECKENTAG
  FORTBILDUNG
}

// Eine Abwesenheit sperrt entweder nur die Slots einer Aerzt:in oder (als
// Praxisschliessung) alle Slots des Tages. SPEC Beziehung 7: leerer aerztinId
// bedeutet Praxisschliessung.
model Abwesenheit {
  id             Int             @id @default(autoincrement())
  von            DateTime
  bis            DateTime
  geltungsbereich Geltungsbereich
  art            AbwesenheitArt
  aerztinId      Int?
  aerztin        Aerztin?        @relation(fields: [aerztinId], references: [id], onDelete: Cascade)
  erfasstAm      DateTime        @default(now())

  @@map("abwesenheit")
}

// --- F-004 Einwilligung (Opt-in) verwalten (BR9) ---

enum EinwilligungsKanal {
  SMS
  EMAIL
}

// Je Patient:in und Kanal hoechstens ein Eintrag (SPEC Beziehung 11). Der
// Widerruf setzt widerrufenAm, der Eintrag bleibt fuer den Verlauf bestehen.
model Einwilligung {
  id           Int               @id @default(autoincrement())
  patientId    Int
  kanal        EinwilligungsKanal
  erteiltAm    DateTime          @default(now())
  widerrufenAm DateTime?
  patient      Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, kanal])
  @@map("einwilligung")
}

// --- F-005 Termine erfassen, aendern und absagen (BR5, BR7) ---

// Die MFA erfasst Termine. Alle MFAs haben dieselben Rechte (BR7).
model MFA {
  id      Int      @id @default(autoincrement())
  name    String
  termine Termin[]
  rezepte Rezeptantrag[] @relation("RezeptAngelegt")
  erstgespraeche Erstgespraech[]

  @@map("mfa")
}

// --- F-006 Akut-Kontingent je Halbtag (BR1) ---

// Praxisweite Einstellungen als Einzelzeile (id ist immer 1). Die SPEC nennt
// keine Zahl fuer das Akut-Kontingent (offene Frage M2-8), deshalb ist der Wert
// einstellbar und nicht fest im Code.
model PraxisEinstellung {
  id                       Int @id @default(1)
  akutKontingentProHalbtag Int @default(2)

  @@map("praxis_einstellung")
}

// --- F-007 No-Show erfassen, zaehlen, erinnern und sperren (BR2) ---

enum ErinnerungsKanal {
  EMAIL
  BRIEF
  ANRUF
}

// Aufgabe fuer die MFA: schriftliche Erinnerung nach dem zweiten No-Show. Der
// Versand selbst ist eine MFA-Aufgabe (SPEC §7), die App legt nur die Aufgabe an.
model Erinnerung {
  id          Int              @id @default(autoincrement())
  patientId   Int
  terminId    Int?
  kanal       ErinnerungsKanal
  ausgeloestAm DateTime        @default(now())
  erledigtAm  DateTime?
  notiz       String?
  patient     Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  termin      Termin?          @relation(fields: [terminId], references: [id])

  @@map("erinnerung")
}

// --- F-008 Rezeptantrag anlegen und freigeben (BR3) ---

enum RezeptStatus {
  ANGELEGT
  FREIGEGEBEN
}

// Die MFA legt den Wiederholungsrezept-Antrag an, nur eine Aerzt:in gibt ihn
// frei (Arztvorbehalt). SPEC Beziehungen 8-10.
model Rezeptantrag {
  id              Int          @id @default(autoincrement())
  patientId       Int
  angelegtVonId   Int
  freigegebenVonId Int?
  status          RezeptStatus @default(ANGELEGT)
  datum           DateTime     @default(now())
  freigegebenAm   DateTime?
  notiz           String?
  patient         Patient      @relation(fields: [patientId], references: [id])
  angelegtVon     MFA          @relation("RezeptAngelegt", fields: [angelegtVonId], references: [id])
  freigegebenVon  Aerztin?     @relation("RezeptFreigegeben", fields: [freigegebenVonId], references: [id])

  @@map("rezeptantrag")
}

// --- F-009 Erstgespraech vorklaeren und Termin vergeben (BR6, BR8) ---

// Protokoll der telefonischen Vorklaerung durch die MFA. Das Erstgespraech
// selbst fuehrt eine Aerzt:in in der Praxis; es ist nicht online buchbar.
model Erstgespraech {
  id              Int      @id @default(autoincrement())
  patientId       Int
  mfaId           Int
  aerztinId       Int
  terminId        Int      @unique
  situation       String
  dringlichkeit   String
  aufnahmeMoeglich Boolean
  erfasstAm       DateTime @default(now())
  patient         Patient  @relation(fields: [patientId], references: [id])
  mfa             MFA      @relation(fields: [mfaId], references: [id])
  aerztin         Aerztin  @relation(fields: [aerztinId], references: [id])
  termin          Termin   @relation(fields: [terminId], references: [id])

  @@map("erstgespraech")
}

// --- F-010 Nachtrag erfassen (informelle Kulanz, BR1/W2) ---

// Ein nachtraeglich erfasster Termin, den die MFA in Absprache mit einer Aerzt:in
// informell in den Praxisablauf geschoben hat. Er belegt keinen Slot.
model Nachtrag {
  id             Int      @id @default(autoincrement())
  terminId       Int      @unique
  abspracheMitId Int
  datum          DateTime
  notiz          String?
  erfasstAm      DateTime @default(now())
  termin         Termin   @relation(fields: [terminId], references: [id], onDelete: Cascade)
  abspracheMit   Aerztin  @relation("NachtragAbsprache", fields: [abspracheMitId], references: [id])

  @@map("nachtrag")
}
