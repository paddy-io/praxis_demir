// Prisma 7 Schema. Die Verbindungs-URL steht in prisma.config.ts.
// Modelle entstehen Feature fuer Feature (siehe docs/backlog.md).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// --- F-001 Terminplan und Slots pflegen (BR6, BR7) ---

enum Halbtag {
  VORMITTAG
  NACHMITTAG
}

enum SlotArt {
  NORMAL
  AKUT
}

enum SlotStatus {
  FREI
  BELEGT
}

model Aerztin {
  id           Int                @id @default(autoincrement())
  name         String
  slots        Slot[]
  terminarten  AerztinTerminart[]
  termine      Termin[]
  abwesenheiten Abwesenheit[]

  @@map("aerztin")
}

model Terminart {
  id           Int                @id @default(autoincrement())
  bezeichnung  String             @unique
  dauerMinuten Int
  onlineBuchbar Boolean           @default(false)
  aerztinnen   AerztinTerminart[]
  termine      Termin[]

  @@map("terminart")
}

// n:m "Aerztin darf Terminart durchfuehren" (SPEC Beziehung 4).
model AerztinTerminart {
  aerztinId   Int
  terminartId Int
  aerztin     Aerztin   @relation(fields: [aerztinId], references: [id], onDelete: Cascade)
  terminart   Terminart @relation(fields: [terminartId], references: [id], onDelete: Cascade)

  @@id([aerztinId, terminartId])
  @@map("aerztin_terminart")
}

model Slot {
  id       Int        @id @default(autoincrement())
  datum    DateTime
  beginn   String     // Uhrzeit "HH:MM", Beginn des Slots
  halbtag  Halbtag
  art      SlotArt    @default(NORMAL)
  status   SlotStatus @default(FREI)
  aerztinId Int
  aerztin  Aerztin    @relation(fields: [aerztinId], references: [id], onDelete: Cascade)
  termin   Termin?

  // Ein Slot je Aerztin, Tag und Uhrzeit (Grundlage fuer "ein Slot, ein Termin").
  @@unique([aerztinId, datum, beginn])
  @@map("slot")
}

// --- F-002 Online-Termin buchen (BR5, BR6, BR9) ---

enum Versicherungsart {
  GESETZLICH
  PRIVAT
}

enum PatientStatus {
  NEU
  BESTAND
}

enum TerminStatus {
  GEBUCHT
  ERSCHIENEN
  ABSAGT
  NO_SHOW
  BETROFFEN
}

enum TerminKanal {
  TELEFON
  TRESEN
  ONLINE
}

model Patient {
  id                   Int              @id @default(autoincrement())
  name                 String
  versicherungsart     Versicherungsart
  // Schluessel je Versicherungsart (SPEC 2): gesetzlich ueber Versichertennummer,
  // privat ueber interne Patientennummer. Beide optional, aber eindeutig.
  versichertennummer   String?          @unique
  patientennummer      String?          @unique
  status               PatientStatus    @default(BESTAND)
  onlineBuchungGesperrt Boolean         @default(false)
  termine              Termin[]

  @@map("patient")
}

model Termin {
  id                   Int            @id @default(autoincrement())
  status               TerminStatus   @default(GEBUCHT)
  kanal                TerminKanal    @default(ONLINE)
  nachtraeglichErfasst Boolean        @default(false)
  dringlichkeit        String?
  patientId            Int
  aerztinId            Int
  terminartId          Int
  // BR5: hoechstens ein Termin je Slot. Die Eindeutigkeit erzwingt das auf
  // Datenbank-Ebene, unabhaengig vom Kanal.
  slotId               Int            @unique
  patient              Patient        @relation(fields: [patientId], references: [id])
  aerztin              Aerztin        @relation(fields: [aerztinId], references: [id])
  terminart            Terminart      @relation(fields: [terminartId], references: [id])
  slot                 Slot           @relation(fields: [slotId], references: [id])

  @@map("termin")
}

// --- F-003 Abwesenheit und Praxisschliessung (BR4) ---

enum Geltungsbereich {
  AERZTIN
  PRAXIS
}

enum AbwesenheitArt {
  URLAUB
  BRUECKENTAG
  FORTBILDUNG
}

// Eine Abwesenheit sperrt entweder nur die Slots einer Aerzt:in oder (als
// Praxisschliessung) alle Slots des Tages. SPEC Beziehung 7: leerer aerztinId
// bedeutet Praxisschliessung.
model Abwesenheit {
  id             Int             @id @default(autoincrement())
  von            DateTime
  bis            DateTime
  geltungsbereich Geltungsbereich
  art            AbwesenheitArt
  aerztinId      Int?
  aerztin        Aerztin?        @relation(fields: [aerztinId], references: [id], onDelete: Cascade)
  erfasstAm      DateTime        @default(now())

  @@map("abwesenheit")
}
